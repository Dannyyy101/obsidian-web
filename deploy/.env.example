# Öffentliche Domain der App (ohne https://)
PUBLIC_HOST=notes.example.com

# Zitadel: Projekt → App (Typ "Web", Auth-Methode "Code")
# Redirect-URI dort: https://<PUBLIC_HOST>/oauth2/callback
ZITADEL_ISSUER=https://auth.example.com
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# 32 zufällige Bytes: openssl rand -base64 32 | tr -- '+/' '-_' | head -c 32
COOKIE_SECRET=

# Pflicht: nur diese Hosts darf der Sync-Proxy ansprechen (kommagetrennt), z. B. dein S3/WebDAV.
# Gilt auch für Weiterleitungen. "*" erlaubt alle Hosts, auch im internen Netz – nicht empfohlen.
PROXY_ALLOWED_HOSTS=
